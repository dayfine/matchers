# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "PPX deriver for exhaustive record matchers in test assertions"
maintainer: ["Di Fan"]
authors: ["Di Fan"]
license: "MIT"
homepage: "https://github.com/dayfine/matchers"
bug-reports: "https://github.com/dayfine/matchers/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2.0"}
  "ppxlib"
  "ounit2" {with-test}
  "matchers" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dayfine/matchers.git"
