opam-version: "2.0"
version: "0.1.0"
synopsis: "OUnit2 matchers for Status.status_or results"
description:
  "Matchers for Status.status_or results: is_ok, is_ok_and_holds and is_error that print the status on failure, and is_error_with for checking a status code and message. Builds on the matchers and status packages."
maintainer: ["Di Fan"]
authors: ["Di Fan"]
license: "MIT"
homepage: "https://github.com/dayfine/matchers"
bug-reports: "https://github.com/dayfine/matchers/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2.0"}
  "core"
  "ounit2"
  "matchers"
  "status"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dayfine/matchers.git"
