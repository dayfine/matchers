# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Composable test matchers for OUnit2"
description:
  "A fluent matcher API for OUnit2 tests: equality, float and ordering matchers, field and combinator matchers, generic Result and Option matchers, and list and map matchers."
maintainer: ["Di Fan"]
authors: ["Di Fan"]
license: "MIT"
homepage: "https://github.com/dayfine/matchers"
bug-reports: "https://github.com/dayfine/matchers/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2.0"}
  "core"
  "ounit2"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dayfine/matchers.git"
